# Asymmetric tab surface: vertical left edge and a smooth right descent
@class rm_tab_surface
@name sloped_cad_tab
@version 1
@var x float
@var y float
@var width float
@var height float
@var right float
@var bottom float
@var center_x float
@var center_y float
@var inner_x float
@var inner_y float
@var inner_width float
@var inner_height float
@var inner_right float
@var inner_bottom float
@var state uint
@prop fill_r float $state 0.145 0.19 0.12 0.10 0.245 0.27 0.20 0.13
@prop fill_g float $state 0.15 0.20 0.13 0.105 0.255 0.285 0.22 0.135
@prop fill_b float $state 0.155 0.21 0.14 0.11 0.265 0.30 0.24 0.145
@prop fill_a float $state 1 1 1 1 1 1 1 1
@prop stroke_r float $state 0.31 0.07 0.06 0.22 0.08 0.08 0.06 0.22
@prop stroke_g float $state 0.32 0.56 0.45 0.22 0.60 0.68 0.48 0.22
@prop stroke_b float $state 0.33 0.78 0.68 0.23 0.82 0.90 0.72 0.23
@prop stroke_a float $state 1 1 1 0.6 1 1 1 0.6
@prop indicator_a float $state 0 0 0 0 1 1 1 0.55

begin_path
move_to $inner_x $inner_bottom
line_to $inner_x $inner_y
line_to $center_x $inner_y
bezier_to $inner_right $inner_y $inner_right $center_y $inner_right $inner_bottom
close_path
fill_color %fill_r %fill_g %fill_b %fill_a
fill
stroke_width 1
stroke_color %stroke_r %stroke_g %stroke_b %stroke_a
stroke
begin_path
move_to $inner_x $inner_bottom
line_to $inner_right $inner_bottom
stroke_width 2
stroke_color 0.08 0.62 0.88 %indicator_a
stroke
