# Strict CAD-style button surface
@class rm_button_surface
@name strict_cad_button
@version 1
@var x float
@var y float
@var width float
@var height float
@var right float
@var bottom float
@var center_x float
@var center_y float
@var inner_x float
@var inner_y float
@var inner_width float
@var inner_height float
@var inner_right float
@var inner_bottom float
@var state uint
@prop fill_r float $state 0.188 0.235 0.145 0.118 0.188 0.235 0.145 0.118
@prop fill_g float $state 0.196 0.247 0.157 0.122 0.196 0.247 0.157 0.122
@prop fill_b float $state 0.204 0.259 0.169 0.129 0.204 0.259 0.169 0.129
@prop fill_a float $state 1 1 1 1 1 1 1 1
@prop stroke_r float $state 0.34 0.08 0.06 0.24 0.34 0.08 0.06 0.24
@prop stroke_g float $state 0.35 0.60 0.48 0.24 0.35 0.60 0.48 0.24
@prop stroke_b float $state 0.36 0.82 0.72 0.25 0.36 0.82 0.72 0.25
@prop stroke_a float $state 1 1 1 0.65 1 1 1 0.65

begin_path
rounded_rect $inner_x $inner_y $inner_width $inner_height 3
fill_color %fill_r %fill_g %fill_b %fill_a
fill
stroke_width 1
stroke_color %stroke_r %stroke_g %stroke_b %stroke_a
stroke
